{
  "compilerOptions": {
    "module": "commonjs", "declaration": false, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "target": "ES2022", "sourceMap": true, "outDir": "./dist",
    "strict": true, "strictPropertyInitialization": false, "skipLibCheck": true, "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
